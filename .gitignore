# Root .gitignore for College Event Portal (MERN Stack)

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.*
!*/.env.example

# Production Builds
dist/
build/
*/dist/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage / Testing
coverage/
*/coverage/
.nyc_output/
*.lcov

# OS & Editor Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Temporary files & caches
.eslintcache
.stylelintcache
.cache/
.temp/
.tmp/
